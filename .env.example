# Multilingual Transcriber - Environment Variables Example
# Copy this file to .env and fill in your values

# === BACKEND ===
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# === OLLAMA (Optional) ===
# Leave blank to disable LLM generation and use context-only fallback
OLLAMA_HOST=http://localhost:11434
# For production Ollama on separate instance:
# OLLAMA_HOST=https://ollama-service.onrender.com

# === FRONTEND ===
# URL of the backend API
# Local development:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (Render):
# NEXT_PUBLIC_API_URL=https://multilingual-transcriber-backend.onrender.com

# === DATABASE (Optional, for production) ===
# DATABASE_URL=postgresql://user:password@localhost:5432/multilingual_transcriber

# === AWS S3 (Optional, for file storage) ===
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1

# === MONITORING (Optional) ===
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# DATADOG_API_KEY=your-datadog-key
